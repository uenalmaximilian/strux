enum TokenType {
    TOKEN_NUMBER,

    TOKEN_PLUS,
    TOKEN_MINUS,
    TOKEN_ASTERISK,
    TOKEN_DIV,
    TOKEN_MOD,
    TOKEN_SIZEOF,
    TOKEN_AMPERSAND,
    TOKEN_BIT_OR,
    TOKEN_BIT_XOR,
    TOKEN_BIT_NOT,
    TOKEN_BITSHIFT_LEFT,
    TOKEN_BITSHIFT_RIGHT,
    TOKEN_INC,
    TOKEN_DEC,

    TOKEN_PLUS_ASSIGN,
    TOKEN_MINUS_ASSIGN,
    TOKEN_MUL_ASSIGN,
    TOKEN_DIV_ASSIGN,
    TOKEN_MOD_ASSIGN,
    TOKEN_BIT_AND_ASSIGN,
    TOKEN_BIT_OR_ASSIGN,
    TOKEN_BIT_XOR_ASSIGN,
    TOKEN_LSHIFT_ASSIGN,
    TOKEN_RSHIFT_ASSIGN,

    TOKEN_TYPE_EQ,
    TOKEN_EQ,
    TOKEN_NEQ,
    TOKEN_LT,
    TOKEN_GT,
    TOKEN_LEQ,
    TOKEN_GEQ,
    TOKEN_AND,
    TOKEN_OR,

    TOKEN_ASSIGN,
    TOKEN_LPAREN,
    TOKEN_RPAREN,
    TOKEN_LBRACE,
    TOKEN_RBRACE,
    TOKEN_LBRACKET,
    TOKEN_RBRACKET,

    TOKEN_DOT,
    TOKEN_ARROW,
    TOKEN_COMMA,
    TOKEN_COLON,
    TOKEN_SEMICOLON,

    TOKEN_IF,
    TOKEN_ELIF,
    TOKEN_ELSE,
    TOKEN_THEN,
    TOKEN_SWITCH,
    TOKEN_CASE,
    TOKEN_WHILE,
    TOKEN_FOR,
    TOKEN_DO,
    TOKEN_END,
    TOKEN_BREAK,
    TOKEN_CONTINUE,
    TOKEN_RETURN,

    TOKEN_EXTERN,
    TOKEN_ENUM,
    TOKEN_CLASS,
    TOKEN_INTERFACE,
    TOKEN_BIND,

    TOKEN_INCLUDE,
    TOKEN_IMPORT,
    TOKEN_GUARD,
    TOKEN_DEFINE,

    TOKEN_BOOL,
    TOKEN_CHAR,

    TOKEN_TYPE,
    TOKEN_QUALIFIER,

    TOKEN_STRING,
    TOKEN_ID,

    TOKEN_COMMENT,
    TOKEN_MULTILINE_COMMENT,

    TOKEN_EOF
}

class Token {
    TokenType type
    char* value
    int line
    int col

    void init(TokenType type_, char* value_) {
        type = type_
        value = value_
    }

    char* get_token_type_name(TokenType t) {
        switch t
            case TOKEN_NUMBER: return "NUMBER"
            case TOKEN_PLUS: return "PLUS"
            case TOKEN_MINUS: return "MINUS"
            case TOKEN_ASTERISK: return "ASTERISK"
            case TOKEN_DIV: return "DIV"
            case TOKEN_MOD: return "MOD"
            case TOKEN_SIZEOF: return "SIZEOF"
            case TOKEN_AMPERSAND: return "AMPERSAND"
            case TOKEN_BIT_OR: return "BIT_OR"
            case TOKEN_BIT_XOR: return "BIT_XOR"
            case TOKEN_BIT_NOT: return "BIT_NOT"
            case TOKEN_BITSHIFT_LEFT: return "BITSHIFT_LEFT"
            case TOKEN_BITSHIFT_RIGHT: return "BITSHIFT_RIGHT"
            case TOKEN_INC: return "INC"
            case TOKEN_DEC: return "DEC"
            case TOKEN_PLUS_ASSIGN: return "PLUS_ASSIGN"
            case TOKEN_MINUS_ASSIGN: return "MINUS_ASSIGN"
            case TOKEN_MUL_ASSIGN: return "MUL_ASSIGN"
            case TOKEN_DIV_ASSIGN: return "DIV_ASSIGN"
            case TOKEN_MOD_ASSIGN: return "MOD_ASSIGN"
            case TOKEN_BIT_AND_ASSIGN: return "BIT_AND_ASSIGN"
            case TOKEN_BIT_OR_ASSIGN: return "BIT_OR_ASSIGN"
            case TOKEN_BIT_XOR_ASSIGN: return "BIT_XOR_ASSIGN"
            case TOKEN_LSHIFT_ASSIGN: return "BITSHIFT_LEFT_ASSIGN"
            case TOKEN_RSHIFT_ASSIGN: return "BITSHIFT_RIGHT_ASSIGN"
            case TOKEN_TYPE_EQ: return "TYPE_EQ"
            case TOKEN_EQ: return "EQ"
            case TOKEN_NEQ: return "NEQ"
            case TOKEN_LT: return "LT"
            case TOKEN_GT: return "GT"
            case TOKEN_LEQ: return "LEQ"
            case TOKEN_GEQ: return "GEQ"
            case TOKEN_AND: return "AND"
            case TOKEN_OR: return "OR"
            case TOKEN_ASSIGN: return "ASSIGN"
            case TOKEN_LPAREN: return "LEFT_PARENTHESIS"
            case TOKEN_RPAREN: return "RIGHT_PARENTHESIS"
            case TOKEN_LBRACE: return "LEFT_BRACE"
            case TOKEN_RBRACE: return "RIGHT_BRACE"
            case TOKEN_LBRACKET: return "LEFT_BRACKET"
            case TOKEN_RBRACKET: return "RIGHT_BRACKET"
            case TOKEN_DOT: return "DOT"
            case TOKEN_ARROW: return "ARROW"
            case TOKEN_COMMA: return "COMMA"
            case TOKEN_COLON: return "COLON"
            case TOKEN_SEMICOLON: return "SEMICOLON"
            case TOKEN_IF: return "IF"
            case TOKEN_ELIF: return "ELIF"
            case TOKEN_ELSE: return "ELSE"
            case TOKEN_THEN: return "THEN"
            case TOKEN_SWITCH: return "SWITCH"
            case TOKEN_CASE: return "CASE"
            case TOKEN_WHILE: return "WHILE"
            case TOKEN_FOR: return "FOR"
            case TOKEN_DO: return "DO"
            case TOKEN_END: return "END"
            case TOKEN_BREAK: return "BREAK"
            case TOKEN_CONTINUE: return "CONTINUE"
            case TOKEN_RETURN: return "RETURN"
            case TOKEN_EXTERN: return "EXTERN"
            case TOKEN_ENUM: return "ENUM"
            case TOKEN_CLASS: return "CLASS"
            case TOKEN_INTERFACE: return "INTERFACE"
            case TOKEN_BIND: return "BIND"
            case TOKEN_INCLUDE: return "INCLUDE"
            case TOKEN_IMPORT: return "IMPORT"
            case TOKEN_GUARD: return "GUARD"
            case TOKEN_DEFINE: return "DEFINE"
            case TOKEN_BOOL: return "BOOL"
            case TOKEN_CHAR: return "CHAR"
            case TOKEN_TYPE: return "TYPE"
            case TOKEN_QUALIFIER: return "QUALIFIER"
            case TOKEN_STRING: return "STRING"
            case TOKEN_ID: return "ID"
            case TOKEN_COMMENT: return "COMMENT"
            case TOKEN_MULTILINE_COMMENT: return "MULTILINE_COMMENT"
            case TOKEN_EOF: return "EOF"
            else: return "UNKNOWN"
        end
    }
}